APP_NAME=CampusKart API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
APP_DATABASE_URL=postgresql+psycopg://campuskart_app:YOUR_APP_ROLE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
APP_DATABASE_ROLE=campuskart_app
FRONTEND_ORIGINS=["http://localhost:5173"]
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CampusKart
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
MEDIA_ROOT=uploads
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
